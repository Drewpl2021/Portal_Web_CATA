# URL base del módulo Portal web en RR.HH.
# Vacía: npm run dev usa los datos de prueba locales (src/api/mock).
# Obligatoria para npm run build; sin ella el build se detiene. Para una versión con datos de prueba: npm run build:demo.
VITE_API_URL=
# Solo con datos locales: escenario por defecto y retraso simulado (ms).
VITE_MOCK_ESCENARIO=tipico
VITE_MOCK_RETRASO=0
